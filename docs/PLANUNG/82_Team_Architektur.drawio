<mxfile host="app.diagrams.net"><diagram name="Team-Architektur Spec 82" id="fa-spec82"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z301" value="Food Alchemist · Team-Architektur (Spec 82)" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#131a26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="z302" value="Stand 13.10.2026 · Plattform-Stamm → Master-Team → Oberteam (Mandant) → Unter-Teams → KI · so wie besprochen" style="text;html=1;fontSize=12;fontColor=#657084;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="22" as="geometry"/></mxCell><mxCell id="z303" value="A · PLATTFORM-STAMM  ·  global (team_id NULL)  ·  Pflege nur durch Master" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#c5ccd8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#131a26;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1160" height="190" as="geometry"/></mxCell><mxCell id="z304" value="&lt;b&gt;Basis – bekommt JEDES Team&lt;/b&gt;&lt;br&gt;&lt;br&gt;Regeln · Hausstandards&lt;br&gt;Vokabular (Einheiten, Equipment …)&lt;br&gt;Wissen · Pairing&lt;br&gt;&lt;br&gt;damit der Food Alchemist funktioniert" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="300" height="135" as="geometry"/></mxCell><mxCell id="z305" value="&lt;b&gt;Stamm-Paket – optional, Opt-in&lt;/b&gt;&lt;br&gt;&lt;br&gt;Grundprodukte (kuratierter, sicherer Stamm)&lt;br&gt;Necta-Artikel aller Stamm-Lieferanten&lt;br&gt;&lt;b&gt;Verknüpfung Artikel → GP&lt;/b&gt; (einmal zentral gepflegt)&lt;br&gt;&lt;br&gt;live, nur lesend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="370" y="115" width="430" height="135" as="geometry"/></mxCell><mxCell id="z306" value="&lt;b&gt;Kunde sagt „nein“&lt;/b&gt;&lt;br&gt;&lt;br&gt;leeres System: nur Basis&lt;br&gt;baut Grundprodukte, Lieferanten&lt;br&gt;und Artikel selbst auf&lt;br&gt;&lt;br&gt;(autark oder bewusst ohne Stamm)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#ffffff;strokeColor=#8b97ad;dashed=1;" vertex="1" parent="1"><mxGeometry x="830" y="115" width="330" height="135" as="geometry"/></mxCell><mxCell id="z307" value="B · MASTER-TEAM  ·  BHG.DIGITAL  ·  ein Team mit FA-Admin-Rechten, keine eigene Ebene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#c5ccd8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#131a26;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="1160" height="190" as="geometry"/></mxCell><mxCell id="z308" value="&lt;b&gt;BHG.DIGITAL&lt;/b&gt;&lt;br&gt;Master-Team&lt;br&gt;&lt;br&gt;pflegt Stamm + Bibliothek&lt;br&gt;arbeitet in Mandanten mit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#131a26;strokeColor=#131a26;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="200" height="135" as="geometry"/></mxCell><mxCell id="z309" value="&lt;b&gt;Master-Bibliothek&lt;/b&gt;&lt;br&gt;&lt;br&gt;Basisrezepte · Gerichte&lt;br&gt;Konzepte · Formate&lt;br&gt;Vorlagen (DNA, Profil, Projekt)&lt;br&gt;&lt;br&gt;sieht nur der Master" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="270" y="320" width="240" height="135" as="geometry"/></mxCell><mxCell id="z310" value="&lt;b&gt;Abo-Freigabe je Sammlung&lt;/b&gt;&lt;br&gt;&lt;br&gt;live + nur lesend beim Mandanten&lt;br&gt;Master ändert → alle haben es&lt;br&gt;&lt;br&gt;&lt;b&gt;Eigene Kopie&lt;/b&gt; nur als Ausnahme&lt;br&gt;(„Original geändert“ → übernehmen)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="300" height="135" as="geometry"/></mxCell><mxCell id="z311" value="&lt;b&gt;Modul „Mandanten“ (nur Master)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Teamprofil + DNA je Team pflegen&lt;br&gt;Rückschlüsse quer über alle Teams&lt;br&gt;Vorlagen als Kopie weitergeben&lt;br&gt;Abo- und Kopie-Stand je Rezept" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="870" y="320" width="290" height="135" as="geometry"/></mxCell><mxCell id="z312" value="C · OBERTEAM  ·  Mandant / Controlling Center  ·  kuratiert oder autark  ·  funktioniert auch ohne Unter-Teams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#c5ccd8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#131a26;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="1160" height="250" as="geometry"/></mxCell><mxCell id="z313" value="&lt;b&gt;Oberteam&lt;/b&gt;&lt;br&gt;&lt;br&gt;Broich Catering&lt;br&gt;TM Food Solutions&lt;br&gt;Soulkitchen Group&lt;br&gt;&lt;br&gt;Kunden-IP: alles, was hier entsteht, gehört dem Mandanten" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#131a26;strokeColor=#131a26;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="525" width="200" height="195" as="geometry"/></mxCell><mxCell id="z314" value="&lt;b&gt;Artikelstamm in 4 Schritten&lt;/b&gt;&lt;br&gt;① Lieferanten wählen (Matrix Lieferant × Warengruppe)&lt;br&gt;② eigene Preisliste mit Art.-Nr. hochladen&lt;br&gt;③ Match über Art.-Nr. + Lieferant&lt;br&gt;④ fertiger Artikelstamm, sofort arbeitsfähig" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="270" y="525" width="300" height="120" as="geometry"/></mxCell><mxCell id="z315" value="&lt;b&gt;Eigene Preise je Mandant&lt;/b&gt;&lt;br&gt;entschieden 13.10. · Import: CSV oder Necta" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#fdf3dc;strokeColor=#e0b44d;" vertex="1" parent="1"><mxGeometry x="270" y="655" width="300" height="65" as="geometry"/></mxCell><mxCell id="z316" value="&lt;b&gt;Food-DNA = Vorgaben&lt;/b&gt;&lt;br&gt;Felder als verbindlich markierbar" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="600" y="525" width="270" height="60" as="geometry"/></mxCell><mxCell id="z317" value="&lt;b&gt;Gemeinsame Rezepte + Foodbooks&lt;/b&gt;&lt;br&gt;alle Unter-Teams sehen sie" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="600" y="592" width="270" height="60" as="geometry"/></mxCell><mxCell id="z318" value="&lt;b&gt;Einstellungen „Unter-Teams &amp;amp; Freigaben“&lt;/b&gt;&lt;br&gt;automatisch fürs Oberteam (aus Controlling)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="600" y="660" width="270" height="60" as="geometry"/></mxCell><mxCell id="z319" value="&lt;b&gt;CRM + Kalkulationsprofile&lt;/b&gt;&lt;br&gt;(Outlet → Kalkulationsprofil)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="900" y="525" width="260" height="60" as="geometry"/></mxCell><mxCell id="z320" value="&lt;b&gt;Controlling&lt;/b&gt;&lt;br&gt;Brille: alle Unter-Teams, nebeneinander" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="900" y="592" width="260" height="60" as="geometry"/></mxCell><mxCell id="z321" value="&lt;b&gt;Abo-Rezepte aus dem Master&lt;/b&gt;&lt;br&gt;nur lesend, rechnen mit eigenen Artikeln" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="900" y="660" width="260" height="60" as="geometry"/></mxCell><mxCell id="z322" value="D · UNTER-TEAMS  ·  optional  ·  frei benannt (WCCB, Kita, Gladbach …)  ·  arbeiten autonom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#c5ccd8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#131a26;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="755" width="1160" height="230" as="geometry"/></mxCell><mxCell id="z323" value="&lt;b&gt;Unter-Team&lt;/b&gt;&lt;br&gt;&lt;br&gt;WCCB&lt;br&gt;Kita&lt;br&gt;Gladbach&lt;br&gt;&lt;br&gt;eigenes Einkauf, Lager, Produktion" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#131a26;strokeColor=#131a26;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="200" height="175" as="geometry"/></mxCell><mxCell id="z324" value="&lt;b&gt;Erbt Artikel + Preise&lt;/b&gt; · Matrix ergänzen · Lead-Artikel pinnen" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="270" y="790" width="300" height="50" as="geometry"/></mxCell><mxCell id="z325" value="&lt;b&gt;Lokale Rezepte&lt;/b&gt; – Oberteam sieht sie per Brille, kein Hochkopieren" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="270" y="850" width="300" height="50" as="geometry"/></mxCell><mxCell id="z326" value="&lt;b&gt;Freigaben schränken nur ein&lt;/b&gt;&lt;br&gt;Standard: sieht alles vom Oberteam (77d)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="270" y="910" width="300" height="55" as="geometry"/></mxCell><mxCell id="z327" value="&lt;b&gt;Team-DNA&lt;/b&gt; – erbt Vorgaben, überschreibt feldweise" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="600" y="790" width="270" height="50" as="geometry"/></mxCell><mxCell id="z328" value="&lt;b&gt;Teamprofil (Fakten)&lt;/b&gt; – Equipment, Flächen, Pax, Personal" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="600" y="850" width="270" height="50" as="geometry"/></mxCell><mxCell id="z329" value="&lt;b&gt;Machbarkeits-Check&lt;/b&gt;&lt;br&gt;Rezept braucht X – Team hat X? (ohne KI)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="600" y="910" width="270" height="55" as="geometry"/></mxCell><mxCell id="z330" value="&lt;b&gt;Eigenes Controlling&lt;/b&gt; – sieht nur sich" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="900" y="790" width="260" height="50" as="geometry"/></mxCell><mxCell id="z331" value="&lt;b&gt;Angebote&lt;/b&gt; – Endkunde aus dem CRM des Mandanten" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="900" y="850" width="260" height="50" as="geometry"/></mxCell><mxCell id="z332" value="&lt;b&gt;Foodbook&lt;/b&gt;&lt;br&gt;vom Oberteam freigegeben oder eigenes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e6edfe;strokeColor=#bcd3fb;" vertex="1" parent="1"><mxGeometry x="900" y="910" width="260" height="55" as="geometry"/></mxCell><mxCell id="z333" value="E · KI-KASKADE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f5f8;strokeColor=#c5ccd8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#131a26;arcSize=2;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="1160" height="120" as="geometry"/></mxCell><mxCell id="z334" value="&lt;b&gt;KontextResolver (zentral)&lt;/b&gt;&lt;br&gt;Aufrufer geben nur das Objekt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="40" y="1035" width="300" height="65" as="geometry"/></mxCell><mxCell id="z335" value="&lt;b&gt;Oberteam-Vorgaben → Team-DNA → Teamprofil → Endkunde (Angebot) → Foodbook/Concept&lt;/b&gt;&lt;br&gt;feldweise Vorrang · Gesamtbudget" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#e2f2e9;strokeColor=#7fd3a3;" vertex="1" parent="1"><mxGeometry x="370" y="1035" width="560" height="65" as="geometry"/></mxCell><mxCell id="z336" value="&lt;b&gt;AiGateway → LLM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontColor=#131a26;arcSize=8;spacing=5;fillColor=#ffffff;strokeColor=#8b97ad;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="1035" width="200" height="65" as="geometry"/></mxCell><mxCell id="z337" value="immer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f5f8b;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="z304" target="z313"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z338" value="Opt-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1c6e46;strokeWidth=2;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z305" target="z314"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z339" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z309" target="z310"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z340" value="Sammlung freigeben" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1c6e46;strokeWidth=2;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z310" target="z321"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z341" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z308" target="z311"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z342" value="pflegt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1c6e46;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="z311" target="z328"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z343" value="parent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#131a26;strokeWidth=2;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z313" target="z323"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z344" value="vererbt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z314" target="z324"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z345" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b07100;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="z315" target="z314"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z346" value="erbt feldweise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z316" target="z327"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z347" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z318" target="z326"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z348" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="z317" target="z325"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z349" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z327" target="z334"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z350" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z328" target="z334"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z351" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z328" target="z329"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z352" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z334" target="z335"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z353" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#657084;strokeWidth=1;fontSize=10;fontColor=#4a5466;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z335" target="z336"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="z354" value="&lt;b&gt;Leitsätze&lt;/b&gt;&lt;br&gt;1. Der Stamm wird &lt;b&gt;einmal zentral&lt;/b&gt; gepflegt – Mapping Artikel → GP nur einmal.&lt;br&gt;2. Ein Mandant wählt &lt;b&gt;seine Lieferanten&lt;/b&gt; und lädt &lt;b&gt;seine Preisliste&lt;/b&gt; – fertig.&lt;br&gt;3. Ohne Stamm-Paket: leeres System, aber Regeln, Vokabular und Wissen sind immer da.&lt;br&gt;4. Master-Rezepte laufen als &lt;b&gt;Abo&lt;/b&gt; (live), eigene Kopie nur bei Abweichung.&lt;br&gt;5. Jede Rezeptur existiert &lt;b&gt;einmal&lt;/b&gt;: gemeinsam im Oberteam, lokal im Unter-Team.&lt;br&gt;6. Freigaben schränken ein – Standard ist „sieht alles“.&lt;br&gt;7. DNA = wie man kochen will · Teamprofil = was die Küche kann.&lt;br&gt;8. „Betrieb“ entfällt · Outlet heißt Kalkulationsprofil.&lt;br&gt;&lt;br&gt;&lt;b&gt;Status&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1f5f8b&quot;&gt;■&lt;/font&gt; gebaut   &lt;font color=&quot;#1c6e46&quot;&gt;■&lt;/font&gt; neu   &lt;font color=&quot;#b07100&quot;&gt;■&lt;/font&gt; offen / zu entscheiden&lt;br&gt;&lt;br&gt;&lt;b&gt;Offen&lt;/b&gt;&lt;br&gt;• Necta: Preise je Mandant per Schnittstelle?&lt;br&gt;• Lokale Artikel: mappt der Mandant selbst oder Vorschlag an Master?&lt;br&gt;&lt;br&gt;&lt;b&gt;Vor Bau messen (demo)&lt;/b&gt;&lt;br&gt;• Rechnet ein Master-Rezept im Mandanten mit dessen Matrix + Pins?&lt;br&gt;• Hängen Mandanten heute per parent_team_id unter BHG.DIGITAL?&lt;br&gt;&lt;br&gt;&lt;b&gt;Bau-Reihenfolge&lt;/b&gt;&lt;br&gt;&lt;b&gt;Kern:&lt;/b&gt; ① Kaskaden-Fixes ② Navigation + Begriffe ③ Preise je Mandant ④ Stamm-Paket + Preislisten-Import ⑤ Teamprofil + Check ⑥ DNA feldweise + Resolver&lt;br&gt;&lt;b&gt;Kurator-Aufsatz:&lt;/b&gt; ⑦ Master-Bibliothek + Abo ⑧ Modul „Mandanten“ ⑨ Projekte&lt;br&gt;&lt;br&gt;Der Kern funktioniert ohne Master-Team." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c5ccd8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#131a26;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1200" y="80" width="330" height="1040" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>